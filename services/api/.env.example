# Copy to .env to override the defaults. Values are read with the
# READ_ALONG_ prefix, so CORS_ORIGINS becomes READ_ALONG_CORS_ORIGINS.

READ_ALONG_VERSION=0.0.0
READ_ALONG_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Where uploaded EPUBs and audiobooks are written, one directory per job.
READ_ALONG_DATA_DIR=var
# Per-file upload cap in bytes (2 GiB).
READ_ALONG_MAX_UPLOAD_BYTES=2147483648
# Total request bytes, including multipart overhead. Default is twice the file
# cap plus 1 MiB; uncomment to override it explicitly.
# READ_ALONG_MAX_REQUEST_BYTES=4296015872
READ_ALONG_MAX_CONCURRENT_UPLOADS=2
# Running jobs and total admitted jobs (running + queued + cancelled-but-draining).
READ_ALONG_MAX_CONCURRENT_JOBS=1
READ_ALONG_MAX_PENDING_JOBS=4
# Input EPUB limits use expanded member sizes, not compressed ZIP size.
READ_ALONG_MAX_ARCHIVE_BYTES=536870912
READ_ALONG_MAX_ARCHIVE_ENTRY_BYTES=67108864
READ_ALONG_MAX_ARCHIVE_ENTRIES=10000
