# Copy to .env to override the defaults. Values are read with the
# READ_ALONG_ prefix, so CORS_ORIGINS becomes READ_ALONG_CORS_ORIGINS.

READ_ALONG_VERSION=0.0.0
READ_ALONG_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Where uploaded EPUBs and audiobooks are written, one directory per job.
READ_ALONG_DATA_DIR=var
# Per-file upload cap in bytes (2 GiB).
READ_ALONG_MAX_UPLOAD_BYTES=2147483648
